{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": false,
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "salvai",
      "changelog-path": "CHANGELOG.md",
      "include-v-in-tag": true,
      "changelog-sections": [
        {
          "type": "feat",
          "section": "✨ Novidades"
        },
        {
          "type": "fix",
          "section": "🐛 Correções"
        },
        {
          "type": "perf",
          "section": "⚡ Desempenho"
        },
        {
          "type": "refactor",
          "section": "♻️ Melhorias internas"
        },
        {
          "type": "docs",
          "section": "📝 Documentação"
        },
        {
          "type": "build",
          "section": "📦 Build"
        },
        {
          "type": "ci",
          "section": "🤖 Automação",
          "hidden": true
        },
        {
          "type": "chore",
          "section": "🧹 Manutenção",
          "hidden": true
        },
        {
          "type": "style",
          "section": "🎨 Estilo",
          "hidden": true
        },
        {
          "type": "test",
          "section": "✅ Testes",
          "hidden": true
        }
      ]
    }
  }
}
