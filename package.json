{
  "name": "salvai",
  "private": true,
  "description": "Viu, gostou, salvaí. Baixe vídeos e músicas do YouTube, Instagram, TikTok, X e muito mais.",
  "license": "UNLICENSED",
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f",
  "scripts": {
    "postinstall": "husky",
    "dev": ".venv/Scripts/python.exe src/app.py",
    "build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build.ps1",
    "format": "prettier --write . && .venv/Scripts/python.exe -m ruff format src scripts",
    "lint": "prettier --check . && .venv/Scripts/python.exe -m ruff check src scripts && .venv/Scripts/python.exe -m ruff format --check src scripts"
  },
  "lint-staged": {
    "*.{js,cjs,css,html,json,md,yml,yaml}": "prettier --write",
    "*.py": [
      ".venv/Scripts/python.exe -m ruff format",
      ".venv/Scripts/python.exe -m ruff check --fix"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10"
  }
}
